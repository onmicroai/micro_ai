PRODUCTION=False
DEBUG=True
DOMAIN="http://localhost"
CONTACT_EMAIL="[user@example.com]"

# ------------------------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------------------------

#Only for production mode, it limits resources by domain where cookies might be set up. We can set up cookies into sub domains
COOKIES_DOMAIN="dev.onmicro.ai"
SECRET_KEY='your_secret_key'

# host should be "localhost" for native development or "db" for docker-based development
DATABASE_URL='postgresql://postgres:postgres@db:5432/micro_ai'
DATABASE_NAME=micro_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me


GOOGLE_ANALYTICS_ID=''
SENTRY_DSN=''

ACCESS_TOKEN_LIFETIME_MINUTES=60  # Default is 60 minutes
REFRESH_TOKEN_LIFETIME_DAYS=7     # Default is 7 days

SIMPLE_JWT_SIGNING_KEY='your_secret_key'
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost,https://onmicro.ai,https://dev.onmicro.ai, https://staging.onmicro.ai"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost,https://onmicro.ai,https://app.onmicro.ai,https://dev.onmicro.ai, https://staging.onmicro.ai"

# ------------------------------------------------------------------------------------------------
# Stripe — optional. Leave all blank to run without billing (all users get free plan).
# Auto-detected: if STRIPE_TEST_SECRET_KEY (or LIVE in prod) is set, Stripe is enabled.
# ------------------------------------------------------------------------------------------------
STRIPE_LIVE_PUBLIC_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_PUBLIC_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
INDIVIDUAL_PLAN_PRICE_ID=
ENTERPRISE_PLAN_PRICE_ID=
TOP_UP_CREDITS_PLAN_ID=
TOP_UP_CREDITS=200000
DEFAULT_PORTAL_CONFIGURATION_ID=

# Credits per billing cycle when Stripe is disabled (auto-resets monthly). Raise freely.
MONTHLY_CREDIT_LIMIT=10000

# -------------------------
# LiteLLM
# ----------------
LITELLM_DB_USER=change_me
LITELLM_DB_PASSWORD=change_me
LITELLM_DB_NAME=litellm
LITELLM_DB_PORT=5432
LITELLM_DATABASE_URL=postgresql://${LITELLM_DB_USER}:${LITELLM_DB_PASSWORD}@host.docker.internal:${LITELLM_DB_PORT}/${LITELLM_DB_NAME}
STORE_MODEL_IN_DB=True
LITELLM_SALT_KEY=change_me_to_secure_key_in_prod
LITELLM_MASTER_KEY=change_me
LITELLM_BASE_URL=http://om-litellm:4000

# ------------------------------------------------------------------------------------------------
# AI Models
# ------------------------------------------------------------------------------------------------
GOOGLE_API_KEY="gemini_api_key"
OPENAI_API_KEY="openai_api_key"
OPENAI_TTS_API_KEY="openai_api_key_for_tts" #TTS costs are harder to estimate so we keep a separate key for better tracking
ANTHROPIC_API_KEY="claude_api_key"
PERPLEXITY_API_KEY="perplexity_api_key"
DEEPSEEK_API_KEY="deepseek_api_key"
DEFAULT_AI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------------------------
# Default (leave SMTP user/password empty): Postfix-style relay — plain SMTP, port 25, no TLS/auth.
# Docker Compose injects EMAIL_HOST=host.docker.internal so the app reaches Postfix on the host.
# Native Django on the host: omit EMAIL_HOST → localhost.
#
# Host Postfix must allow relay from Docker (e.g. mynetworks / trusted networks for the bridge subnet),
# not only 127.0.0.1.
#
# AWS SES SMTP (optional): set EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, DEFAULT_FROM_EMAIL (verified in SES).
#
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
ACCOUNT_EMAIL_VERIFICATION="mandatory"
#EMAIL_PORT=587
#EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------------------------
# Storage
# Default: local filesystem, no config needed.
# To use AWS S3: set ACCESS_KEY_ID + SECRET_ACCESS_KEY - backend auto-detects from their presence.
# CLOUDFRONT_DOMAIN (backend) and NEXT_PUBLIC_CLOUDFRONT_DOMAIN (frontend) must both be set for
# S3 images to resolve correctly. Frontend uses NEXT_PUBLIC_CLOUDFRONT_DOMAIN to switch upload mode.
# ------------------------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=micro-ai        # defaults to "micro-ai" if not set
AWS_S3_REGION_NAME=us-east-1            # defaults to "us-east-1" if not set
AWS_ACCOUNT_ID=

# CloudFront domain for serving S3 assets (no protocol, no trailing slash)
CLOUDFRONT_DOMAIN=

# ------------------------------------------------------------------------------------------------
# Usage Limits
# ------------------------------------------------------------------------------------------------
FREE_PLAN_MICROAPP_LIMIT="3"
GUEST_USER_SESSION_LIMIT="10"


# ------------------------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------------------------

# URLS
NEXT_PUBLIC_API_URL=${DOMAIN}
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=   # set to same value as CLOUDFRONT_DOMAIN; controls frontend upload mode
OPENAI_TTS_COST_PER_CHARACTER=0.000009
