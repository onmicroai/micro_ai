{
  "realm": "${KEYCLOAK_REALM}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "onmicro-spa",
      "name": "OnMicro.AI SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${DOMAIN}/auth/callback", "${DOMAIN}/auth/callback/*"],
      "webOrigins": ["${DOMAIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DOMAIN}"
      },
      "protocolMappers": [
        {
          "name": "django_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "django_user_id",
            "claim.name": "django_user_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "onmicro-spa-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "onmicro-spa",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [],
  "browserFlow": "browser",
  "attributes": {},
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "django-legacy-users",
        "providerId": "User migration using a REST client",
        "providerType": "org.keycloak.storage.UserStorageProvider",
        "config": {
          "URI": ["http://web:8000/api/auth/federation"],
          "API_TOKEN_ENABLED": ["true"],
          "API_TOKEN": ["${KEYCLOAK_FEDERATION_SHARED_SECRET}"],
          "SEVER_FEDERATION_LINK": ["true"],
          "USE_USER_ID_FOR_CREDENTIAL_VERIFICATION": ["false"]
        }
      }
    ]
  }
}
